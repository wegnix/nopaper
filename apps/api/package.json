{
  "name": "@nopaper/api",
  "version": "1.23.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --conditions=nopaper-source --env-file=.env --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.7",
    "@fastify/rate-limit": "11.2.2",
    "@nopaper/shared": "1.23.0",
    "archiver": "7.0.1",
    "argon2": "0.45.2",
    "drizzle-orm": "^0.45.4",
    "exceljs": "4.4.0",
    "fastify": "5.12.8",
    "jose": "6.2.15",
    "nodemailer": "^10.3.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pg": "8.23.1",
    "pg-boss": "10.4.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "6.0.4",
    "@types/node": "22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
