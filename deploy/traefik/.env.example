# E-mail para a Let's Encrypt avisar sobre certificados (expiração, problemas). Não fica público.
ACME_EMAIL=voce@example.com

# Onde guardar os certificados (fica em DATA_PATH/letsencrypt)
DATA_PATH=/storage/traefik

# Portas do servidor usadas pelo Traefik. Só troque se 80/443 já estiverem ocupadas — e leia
# a seção "Portas" do guia: a Let's Encrypt só valida pela porta 80 pública.
HTTP_PORT=80
HTTPS_PORT=443
