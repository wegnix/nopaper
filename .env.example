# =============================================================================
# NoPaper — configuração de produção
# Copie para .env (cp .env.example .env) e preencha. O .env nunca vai para o git.
# Guia completo: docs/publicacao-com-traefik.md
# =============================================================================

# ---- Domínio ----------------------------------------------------------------
# Endereço onde o sistema vai responder (o DNS precisa apontar para este servidor).
APP_DOMAIN=nopaper.example.com
# URL pública usada nos links de e-mail/Telegram. Vazio = https://APP_DOMAIN
APP_URL=

# ---- Dados permanentes ------------------------------------------------------
# Tudo que não pode ser perdido fica aqui, em subpastas: banco/, anexos/ (boletos, notas,
# comprovantes), backups/ e atualizador/. Apagar ou recriar os containers não mexe nesta pasta.
DATA_PATH=/storage/nopaper

# ---- Banco de dados (PostgreSQL, roda num container junto) ------------------
POSTGRES_DB=nopaper
POSTGRES_USER=nopaper
# Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- Segredos ---------------------------------------------------------------
# Assina as sessões de login. Gere com: openssl rand -base64 48
JWT_SECRET=
# Cifra as senhas/tokens guardados no banco (SMTP, bot do Telegram, backup remoto).
# Opcional, mas recomendado: permite trocar o JWT_SECRET sem perder esses segredos.
# Gere com: openssl rand -base64 48   (guarde junto com os backups: sem ela os segredos não abrem)
SECRETS_KEY=

# ---- Administrador inicial --------------------------------------------------
# Usado UMA vez, no primeiro boot com o banco vazio. A senha é provisória: no primeiro login
# o sistema exige uma nova e pede o nome e o perfil (Pessoal/Empresa) do primeiro espaço.
# Depois disso estas linhas não são mais lidas — apague ao menos o ADMIN_PASSWORD.
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_NAME=Administrador
ADMIN_PASSWORD=
# Sugestão de nome do primeiro espaço (pode ser trocado na tela do primeiro acesso)
ADMIN_ORG_NAME=Principal

# ---- Traefik (já instalado no servidor) -------------------------------------
# Rede Docker do Traefik, entrypoint HTTPS e resolvedor de certificados dele.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# ---- Sem Traefik (outro proxy reverso já cuida do HTTPS) --------------------
# Descomente para publicar a interface numa porta do servidor em vez de usar o Traefik.
# COMPOSE_FILE=docker-compose.yml:deploy/porta-direta.yml
# WEB_PORT=8080
# WEB_BIND=127.0.0.1

# ---- Opcionais --------------------------------------------------------------
# Fuso padrão dos espaços novos e dos logs
TZ=America/Sao_Paulo
# Tamanho máximo de cada anexo (MB)
MAX_UPLOAD_MB=15
# Tamanho máximo de cada arquivo enviado ao contador (MB) — ZIP de notas fiscais costuma ser grande
ACCOUNTING_MAX_UPLOAD_MB=200
# Cota padrão de arquivos por espaço (MB): anexos, documentos do contador e holerites. Ao chegar no
# limite o espaço não envia arquivos novos. Dá para ajustar por espaço em Plataforma → Segurança.
STORAGE_QUOTA_MB=5120
# trace | debug | info | warn | error
LOG_LEVEL=info
# Repositório do GitHub de onde vêm as atualizações (troque se usar um fork)
UPDATE_REPO=wegnix/nopaper
